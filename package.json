{
  "name": "solid-doctor",
  "version": "0.1.0",
  "description": "Code health diagnostics for Solid and SolidStart projects.",
  "license": "UNLICENSED",
  "bin": {
    "solid-doctor": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./oxlint-plugin": {
      "types": "./dist/types/oxlint-plugin.d.ts",
      "import": "./dist/oxlint-plugin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "types": "./dist/types/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && bun build src/cli.ts --target node --outfile dist/cli.js && bun build src/index.ts --target node --outfile dist/index.js && bun build src/oxlint-plugin.ts --target node --outfile dist/oxlint-plugin.js && bun x @typescript/native-preview -p tsconfig.build.json",
    "prepack": "bun run build",
    "scan": "bun src/cli.ts scan",
    "test": "bun test test/*.test.ts",
    "check-types": "bun x @typescript/native-preview --noEmit"
  },
  "keywords": [
    "solid",
    "solidjs",
    "solidstart",
    "lint",
    "diagnostics",
    "code-health"
  ],
  "homepage": "https://github.com/erik-kroon/solid-doctor#readme",
  "bugs": {
    "url": "https://github.com/erik-kroon/solid-doctor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erik-kroon/solid-doctor.git"
  },
  "packageManager": "bun@1.3.9",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native-preview": "^7.0.0-dev.20260508.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
